{
  "hosting": {
    "public": ".deploy",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "firebase-debug.log",
      ".git/**",
      ".firebase/**",
      "README.md",
      "*.cmd",
      "tools/**",
      "wamp/**",
      "**/_VIDEO/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/build-deploy.ps1",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|avif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(css|js|mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
